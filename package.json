{
  "name": "page-object-model-tw",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Mobile automation tests for the Way2Automation MediShop Android app with Taqwright + TypeScript + Page Object Model (iOS support scaffolded but disabled until an iOS build exists)",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "test": "taqwright test --project android",
    "test:ci": "taqwright test --project android-ci",
    "test:device": "taqwright test --project android-device",
    "test:bs": "taqwright test --project browserstack-android",
    "bs:upload": "node scripts/upload-to-browserstack.mjs",
    "test:report": "taqwright test --project android --reporter html && taqwright show-report",
    "report": "taqwright show-report",
    "codegen": "taqwright codegen",
    "inspect": "taqwright inspect",
    "devices": "taqwright devices",
    "doctor": "taqwright doctor",
    "setup:android": "taqwright install --with-avd",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@taqwright/taqwright": "^0.1.0-beta.3",
    "@types/node": "^24.3.0",
    "dotenv": "^17.4.2",
    "typescript": "^5.9.2"
  }
}
